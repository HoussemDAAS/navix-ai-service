OPENAI_API_KEY=sk-proj-...

# Supabase (RAG retrieval through the match_embeddings RPC)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Server
PORT=8000
LOG_LEVEL=info
# Comma-separated browser origins allowed by CORS (the NestJS API calls this
# service server to server, so this only matters if a browser calls it directly).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Optional model overrides (defaults live in the code)
# STUDIO_MODEL=
# STUDIO_SUGGEST_MODEL=
# DIGEST_MODEL=
# MEMORY_MODEL=
# REFERENCE_SUMMARY_MODEL=
# CONTENT_VISION_MODEL=
# CONTENT_UNDERSTAND_CONCURRENCY=4
